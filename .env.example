# ==============================================================================
# MourTrading — Environment Variables Template (Clerk Auth + Supabase PostgreSQL)
# Copy to .env (local development) or configure in Cloud Run / AI Studio Secrets.
# NEVER commit real secrets to version control.
# ==============================================================================

# 1. Server & Application URL
APP_URL="http://localhost:3000"
PORT=3000

# 2. Clerk Authentication (Email Auth, Verification, Passwordless OTP & Sessions)
# Get these from Clerk Dashboard -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# 3. Supabase PostgreSQL Database (Optional — falls back to local server storage if omitted)
# Get these from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://szmpxygiitcxuhgmjtiv.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# 4. Google Gemini AI (Server-side only — required for Mour AI reports)
GEMINI_API_KEY=""

# 5. Administrator Account (Reserved admin email auto-synced with Clerk)
ADMIN_EMAIL="jackwilliam2026a@gmail.com"

# 6. Optional: Session signing key
SESSION_SECRET=""
