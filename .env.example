# ==============================================================================
# MourTrading — Environment Variables Template
# Copy to .env (local development) or configure in Cloud Run / AI Studio Secrets.
# NEVER commit real secrets to version control.
# ==============================================================================

# 1. Server & Application URL
APP_URL="http://localhost:3000"
PORT=3000

# 2. Google Gemini AI (Server-side only)
GEMINI_API_KEY=""

# 3. Administrator Account (Reserved admin email)
ADMIN_EMAIL="jackwilliam2026a@gmail.com"

# 4. Supabase Project Configuration (Required)
VITE_SUPABASE_URL="https://szmpxygiitcxuhgmjtiv.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# 5. Optional: Supabase Service Role Key (Server-side only — enables background 12s alert & signal target evaluator)
SUPABASE_SERVICE_ROLE_KEY=""

# 6. Optional: Resend Transactional Email (Server-side only — for price alert notifications & custom SMTP)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="MourTrading <onboarding@resend.dev>"

# 7. Optional: Session signing key (if omitted, a strong CSPRNG key is generated per process)
SESSION_SECRET=""

# 8. Optional: Payment Provider (Leave empty until Stripe/payment gateway is activated)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
